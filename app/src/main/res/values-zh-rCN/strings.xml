    <!-- Box86/Box64 Environment Variables Help -->
    <string name="box86_64_env_var_help__dynarec_nocritcl"><![CDATA[
        不使用任何临界区<br /><br />
        <b>0</b> : 默认行为<br />
        <b>1</b> : 禁用所有临界区。这可能会导致数据竞争，但在某些情况下能提升性能。
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        处理标志位的方式<br /><br />
        <b>0</b> : 默认行为<br />
        <b>1</b> : 尽可能使用更安全但更慢的标志位处理。
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">像 x86 一样生成 -NAN</string>
    <string name="box86_64_env_var_help__dynarec_fastround">生成精确的 x86 舍入</string>
    <string name="box86_64_env_var_help__dynarec_x87double">使用 Float/Double 进行 x87 模拟</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec 构建大代码块<br /><br />
        <b>0</b> : 不尝试构建尽可能大的块<br />
        <b>1</b> : 构建尽可能大的块<br />
        <b>2</b> : 构建更大的块（当块重叠时继续，但仅限 elf 内存中的块）<br />
        <b>3</b> : 构建更大的块（当块重叠时继续，适用于所有类型的内存）
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        模拟强内存模型<br /><br />
        <b>0</b> : 不进行任何特殊尝试<br />
        <b>1</b> : 在写入内存时启用一些内存屏障（在某些 MOV 指令上）<br />
        <b>2</b> : 包含 1 的所有内容，并对使用 MOV 的每次写入内存都添加内存屏障<br />
        <b>3</b> : 包含 2 的所有内容，并在从内存读取以及某些 SSE/SSE2 指令上添加内存屏障
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_forward">定义构建块时允许的最大前向值</string>
    <string name="box86_64_env_var_help__dynarec_callret">优化 CALL/RET 指令</string>
    <string name="box86_64_env_var_help__dynarec_wait">定义 Dynarec 是否等待 FillBlock 就绪</string>
    <string name="box86_64_env_var_help__dynarec_weakbarrier"><![CDATA[
        调整内存屏障以减少强内存模拟对性能的影响<br /><br />
        <b>0</b> : 使用常规安全屏障<br />
        <b>1</b> : 使用弱屏障以获得轻微性能提升<br />
        <b>2</b> : 使用弱屏障，并另外禁用最后一次写入屏障]]></string>
    <string name="box86_64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        仅生成对齐的原子操作（目前仅限 Arm64）。<br /><br />
        <b>0</b> : 生成处理未对齐原子操作的代码。<br />
        <b>1</b> : 仅生成对齐的原子操作，代码更小且更快，但会对操作未对齐数据地址的 LOCK 前缀指令引起 SIGBUS 错误。]]></string>
    <string name="box86_64_env_var_help__dynarec_df"><![CDATA[
        启用或禁用延迟标志的使用。<br /><br />
        <b>0</b> : 禁用延迟标志的使用。<br />
        <b>1</b> : 启用延迟标志的使用。]]></string>
    <string name="box86_64_env_var_help__dynarec_dirty"><![CDATA[
        允许继续运行未受保护且可能脏的代码块。<br /><br />
        <b>0</b> : 不允许继续运行未受保护且可能脏的代码块。<br />
        <b>1</b> : 允许继续运行在与代码相同的页面中写入数据的代码块。这可以缩短某些游戏的加载时间，但也可能导致意外崩溃。<br />
        <b>2</b> : 检测到 HotPage 时将其标记为 NEVERCLEAN，因此它不会受到写保护，但从该页面构建的块将始终经过测试。这样可能会更快（但某些 SMC 情况可能无法被捕获）。]]></string>
    <string name="box86_64_env_var_help__dynarec_nativeflags"><![CDATA[
        启用或禁用原生标志的使用。<br /><br />
        <b>0</b> : 不使用原生标志。<br />
        <b>1</b> : 尽可能使用原生标志。]]></string>
    <string name="box86_64_env_var_help__dynarec_pause"><![CDATA[
        启用 x86 PAUSE 模拟，可能有助于提升自旋锁的性能。<br /><br />
        <b>0</b> : 忽略 x86 PAUSE 指令。<br />
        <b>1</b> : 使用 YIELD 模拟 x86 PAUSE 指令。<br />
        <b>2</b> : 使用 WFI 模拟 x86 PAUSE 指令。<br />
        <b>3</b> : 使用 SEVL+WFE 模拟 x86 PAUSE 指令。
    ]]></string>
    <string name="box86_64_env_var_help__avx"><![CDATA[
        AVX 和 AVX2 实现，以及 BMI1, BMI2, ADX, FMA, F16C 和 RDANDR 扩展！<br /><br />
        <b>0</b> : 禁用 AVX 扩展<br />
        <b>1</b> : 启用 AVX, BMI1, F16C 和 VAES 扩展。<br />
        <b>2</b> : 在 1 的基础上额外启用 AVX2, BMI2, FMA, ADX, VPCLMULQDQ 和 RDRAND。<br />
    ]]></string>
